{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-memory-governance.local/event_log.schema.json",
  "title": "Event Log Entry",
  "type": "object",
  "required": [
    "id",
    "session_id",
    "timestamp",
    "event_type",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
